# API Gateway URLs
# Android Emulator: localhost del host = 10.0.2.2
# Dispositivo fisico: usar IP de la maquina en la red local
#
# NOTA: El gateway Nginx termina TLS (puerto 443). Todas las URLs deben
# usar https:// o wss://. Jamás http:// ni ws:// en release builds.
#
# Para desarrollo local con cert autofirmado, instalar la CA en el
# emulador/dispositivo o usar --insecure (solo debug).

PETS_API_URL=https://10.0.2.2/api/pets
CHAT_GRAPHQL_URL=https://10.0.2.2/api/chat/graphql
CHAT_WS_URL=wss://10.0.2.2/api/chat/ws
MATCHING_API_URL=https://10.0.2.2/api
MEDIA_API_URL=https://10.0.2.2/api/media
NOTIFICATIONS_API_URL=https://10.0.2.2/api/notifications
